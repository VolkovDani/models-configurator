FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
WORKDIR /opt/export
COPY requirements-export.txt requirements-installer.txt .
RUN pip --disable-pip-version-check install --no-deps --no-cache-dir -r requirements-installer.txt && \
    pip --disable-pip-version-check install --no-deps --only-binary=:all: --no-cache-dir -r requirements-export.txt && \
    pip check && python -c "import torch; from torchvision.ops import nms; from optimum.intel import OVModelForCausalLM; assert torch.version.cuda is None; assert nms(torch.ones((1,4)), torch.ones(1), 0.5).tolist() == [0]"
COPY npu_runtime.py prepare_qwen.py ./
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER 65532:65532
ENTRYPOINT ["python", "/opt/export/prepare_qwen.py", "export", "/source", "/out/qwen"]
