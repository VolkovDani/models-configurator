#!/usr/bin/env python3
"""Install only the pinned runtime wheels in a new private virtual environment."""
import argparse
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("environment", type=Path, help="new environment path (parent must exist)")
    parser.add_argument("--python", default=sys.executable, help="Python interpreter for the new environment")
    args = parser.parse_args()
    environment = args.environment.absolute()
    try:
        environment.mkdir(mode=0o700)
    except FileExistsError:
        parser.exit(1, f"{environment} already exists; use its interpreter explicitly or choose a new path\n")
    package_dir = Path(__file__).resolve().parents[1] / "runtime/npu"
    python = environment / "bin/python"
    try:
        subprocess.run([args.python, "-m", "venv", environment], check=True)
        for requirements in ("requirements-installer.txt", "requirements.txt"):
            subprocess.run([python, "-m", "pip", "--disable-pip-version-check", "install",
                            "--only-binary=:all:", "--no-deps", "-r", package_dir / requirements], check=True)
        subprocess.run([python, "-m", "pip", "check"], check=True)
    except (OSError, subprocess.CalledProcessError, KeyboardInterrupt):
        parser.exit(1, f"incomplete installation at {environment}; inspect it and retry with a new path\n")
    print(python)


if __name__ == "__main__":
    main()
