FROM ollama/ollama:0.40.16@sha256:910d0d8107b538fb0894e63163eb195de0cc7aefcbc666dc62d3b18f71124592
RUN apt-get update \
    && apt-get install -y --no-install-recommends mesa-vulkan-drivers \
    && set -- /usr/share/vulkan/icd.d/intel_icd*.json \
    && test "$#" -eq 1 && test -s "$1" \
    && ln -s "$1" /etc/models-configurator-intel-vulkan.json \
    && rm -rf /var/lib/apt/lists/*
