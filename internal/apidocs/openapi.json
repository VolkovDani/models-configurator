{
  "openapi": "3.1.2",
  "info": {
    "title": "Models Configurator API",
    "version": "v1",
    "description": "HTTP API for trusted applications on the same host or attached to the `models-configurator-clients` Docker network. Start with GET /v1/models and use its full profile ID as `model` in inference requests. Inference and chat token counting share a queue. The two-minute request deadline includes time spent waiting in the queue."
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "Models" },
    { "name": "Inference" },
    { "name": "Status" }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "tags": ["Models"],
        "operationId": "listModels",
        "summary": "List configured profiles",
        "description": "Reads the configured inventory without contacting providers. An empty configuration returns an empty data array.",
        "responses": {
          "200": {
            "description": "Configured model profiles.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModelList" },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "id": "ollama.local-chat.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                      "object": "model",
                      "provider": "ollama",
                      "model": "qwen2.5:7b",
                      "role": "chat"
                    }
                  ]
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": ["Inference"],
        "operationId": "createChatCompletion",
        "summary": "Generate a chat completion",
        "description": "Uses a chat profile and returns one non-streaming completion. For structured output the JSON is encoded in the message content string. OpenVINO NPU requires a strict JSON Schema and uses fixed sampling. Omit temperature and top_p for NPU. NPU responses after profile lookup include X-NPU-Call-ID for diagnostics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "example": {
                "model": "<chat-profile-id>",
                "messages": [{ "role": "user", "content": "Is a review required?" }],
                "response_format": {
                  "type": "json_schema",
                  "json_schema": {
                    "name": "review",
                    "strict": true,
                    "schema": {
                      "type": "object",
                      "properties": { "required": { "type": "boolean" } },
                      "required": ["required"],
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One assistant message.",
            "headers": {
              "X-NPU-Call-ID": {
                "description": "Present for an OpenVINO NPU profile. Correlates the request with worker logs.",
                "schema": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatCompletion" },
                "example": {
                  "object": "chat.completion",
                  "model": "<chat-profile-id>",
                  "choices": [
                    {
                      "index": 0,
                      "finish_reason": "stop",
                      "message": { "role": "assistant", "content": "{\"required\":true}" }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/UnknownProfile" },
          "408": { "$ref": "#/components/responses/Canceled" },
          "409": {
            "description": "OpenVINO NPU profile changed. Error code PROFILE_CHANGED.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": { "$ref": "#/components/responses/BodyTooLarge" },
          "429": { "$ref": "#/components/responses/QueueFull" },
          "502": { "$ref": "#/components/responses/ProviderFailure" },
          "503": {
            "description": "OpenVINO NPU unavailable. Possible error codes are NPU_UNAVAILABLE, NPU_WORKER_EXIT, and NPU_RECOVERY_FAILED.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "504": { "$ref": "#/components/responses/DeadlineExceeded" }
        }
      }
    },
    "/v1/chat/token-count": {
      "post": {
        "tags": ["Inference"],
        "operationId": "countChatTokens",
        "summary": "Count chat input tokens and get the applicable limits",
        "description": "Submit the same body as for a non-streaming chat completion. OpenVINO NPU requires a strict JSON Schema and fixed sampling. It uses its pinned chat template and tokenizer to count input locally and returns the manifest prompt limit and the capped completion limit. Ollama profiles with an explicit context limit return a conservative UTF-8 byte estimate including schema and allowances for chat formatting. The Ollama input budget is the configured context minus the requested or default completion limit. Counting never generates a completion or sends input to external providers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token count or estimate and its applicable budgets. Input can exceed the reported input budget.",
            "headers": {
              "X-NPU-Call-ID": {
                "description": "Present for an OpenVINO NPU profile. Correlates the request with worker logs.",
                "schema": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatTokenCount" },
                "example": {
                  "model": "<chat-profile-id>",
                  "input_tokens": 2100,
                  "max_input_tokens": 2048,
                  "max_completion_tokens": 512,
                  "exact": true
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/UnknownProfile" },
          "408": { "$ref": "#/components/responses/Canceled" },
          "409": {
            "description": "OpenVINO NPU profile changed. Error code PROFILE_CHANGED.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Request exceeds the manager body limit or the serialized OpenVINO NPU socket request exceeds 65,536 bytes. The latter returns error code TOKEN_COUNT_REQUEST_TOO_LARGE.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": { "$ref": "#/components/responses/QueueFull" },
          "501": {
            "description": "Token counting is unavailable for the requested profile or budget. Error code TOKEN_COUNT_UNSUPPORTED.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": { "$ref": "#/components/responses/ProviderFailure" },
          "503": {
            "description": "OpenVINO NPU unavailable. Possible error codes are NPU_UNAVAILABLE, NPU_WORKER_EXIT, and NPU_RECOVERY_FAILED.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "504": { "$ref": "#/components/responses/DeadlineExceeded" }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "tags": ["Inference"],
        "operationId": "createEmbeddings",
        "summary": "Create dense embeddings",
        "description": "Uses an embeddings profile. Vectors are returned in input order. Their dimension depends on the profile. OpenVINO BGE-M3 returns 1024 dimensions and accepts up to 4096 tokens per input including special tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmbeddingRequest" },
              "example": {
                "model": "<embedding-profile-id>",
                "input": ["Hello"],
                "encoding_format": "float"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One vector per input, all of the same dimension.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmbeddingList" },
                "example": {
                  "object": "list",
                  "model": "<embedding-profile-id>",
                  "data": [{ "object": "embedding", "index": 0, "embedding": [0.18, -0.31, 0.09] }]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/UnknownProfile" },
          "408": { "$ref": "#/components/responses/Canceled" },
          "409": { "$ref": "#/components/responses/BGEConflict" },
          "413": { "$ref": "#/components/responses/BGEInputTooLarge" },
          "429": { "$ref": "#/components/responses/QueueFull" },
          "502": { "$ref": "#/components/responses/ProviderFailure" },
          "503": { "$ref": "#/components/responses/BGEUnavailable" },
          "504": { "$ref": "#/components/responses/DeadlineExceeded" }
        }
      }
    },
    "/v1/decisions": {
      "post": {
        "tags": ["Inference"],
        "operationId": "createDecision",
        "summary": "Score choices with a local decision model",
        "description": "Uses a pinned local Ollama decision profile. Obtain the expected artifact digest from the configured profile. A model input restriction returns HTTP 200 with a reason. Confidence and probabilities are model-reported scores and should be reviewed by the client.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DecisionRequest" },
              "example": {
                "model": "<decision-profile-id>",
                "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "state": "An administrator can change the payment limit.",
                "question": {
                  "type": "choice",
                  "instructions": "What does the text describe?",
                  "criteria": { "a": "Permission", "b": "Response time" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision and token counts, or an input restriction.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/DecisionResult" },
                    { "$ref": "#/components/schemas/DecisionRestriction" }
                  ]
                },
                "examples": {
                  "decision": {
                    "value": {
                      "model": "<decision-profile-id>",
                      "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                      "answer": {
                        "type": "choice",
                        "choice": "a",
                        "confidence": 0.75,
                        "probabilities": { "a": 0.75, "b": 0.25 }
                      },
                      "usage": { "input_tokens": 24, "output_tokens": 1 }
                    }
                  },
                  "restriction": {
                    "value": {
                      "model": "<decision-profile-id>",
                      "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                      "reason": "outside_training_context"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/UnknownProfile" },
          "408": { "$ref": "#/components/responses/Canceled" },
          "413": { "$ref": "#/components/responses/BodyTooLarge" },
          "429": { "$ref": "#/components/responses/QueueFull" },
          "502": { "$ref": "#/components/responses/ProviderFailure" },
          "504": { "$ref": "#/components/responses/DeadlineExceeded" }
        }
      }
    },
    "/v1/bge-m3/encode": {
      "post": {
        "tags": ["Inference"],
        "operationId": "encodeBGEM3",
        "summary": "Encode BGE-M3 representations (experimental)",
        "description": "Uses an OpenVINO BGE-M3 profile. Results are in input order and each contains exactly the requested modes. The limit is 4096 tokens per input for dense alone and 128 tokens per input when sparse or colbert is requested, including special tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BGERequest" },
              "example": {
                "model": "<bge-profile-id>",
                "input": ["Submit a request."],
                "modes": ["sparse"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One result per input with the requested representations.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BGEResult" },
                "example": {
                  "model": "<bge-profile-id>",
                  "data": [{ "sparse": { "2104": 0.42, "3120": 0.27 } }]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/UnknownProfile" },
          "408": { "$ref": "#/components/responses/Canceled" },
          "409": { "$ref": "#/components/responses/BGEConflict" },
          "413": { "$ref": "#/components/responses/BGEInputTooLarge" },
          "429": { "$ref": "#/components/responses/QueueFull" },
          "502": { "$ref": "#/components/responses/ProviderFailure" },
          "503": { "$ref": "#/components/responses/BGEUnavailable" },
          "504": { "$ref": "#/components/responses/DeadlineExceeded" }
        }
      }
    },
    "/status": {
      "get": {
        "tags": ["Status"],
        "operationId": "getStatus",
        "summary": "Check provider metadata",
        "description": "Checks provider metadata without running inference. Each row records reachability. Null means the provider did not report a particular flag.",
        "responses": {
          "200": {
            "description": "Status snapshot.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusSnapshot" },
                "example": {
                  "checked_at": "2026-01-01T12:00:00Z",
                  "models": []
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileId": {
        "type": "string",
        "description": "Opaque immutable profile ID from GET /v1/models."
      },
      "ArtifactDigest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "Artifact digest in lowercase hexadecimal without the sha256 prefix."
      },
      "Provider": {
        "type": "string",
        "enum": ["ollama", "openai-compatible", "openvino-npu", "openvino-bge"]
      },
      "ProfileRole": {
        "type": "string",
        "enum": ["chat", "embeddings", "decision"]
      },
      "ModelList": {
        "type": "object",
        "required": ["object", "data"],
        "properties": {
          "object": { "type": "string", "const": "list" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "object", "provider", "model", "role"],
              "properties": {
                "id": { "$ref": "#/components/schemas/ProfileId" },
                "object": { "type": "string", "const": "model" },
                "provider": { "$ref": "#/components/schemas/Provider" },
                "model": { "type": "string", "description": "Model name at the provider." },
                "role": { "$ref": "#/components/schemas/ProfileRole" }
              }
            }
          }
        }
      },
      "NonBlankString": {
        "type": "string",
        "pattern": "\\S"
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "$ref": "#/components/schemas/NonBlankString" }
        }
      },
      "ResponseFormat": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "json_schema"],
        "properties": {
          "type": { "type": "string", "const": "json_schema" },
          "json_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "strict", "schema"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$" },
              "strict": { "type": "boolean", "const": true },
              "schema": { "type": "object", "description": "JSON Schema describing the generated content." }
            }
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "messages"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "$ref": "#/components/schemas/Message" }
          },
          "stream": { "type": "boolean", "const": false, "default": false },
          "max_completion_tokens": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
          "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "response_format": { "$ref": "#/components/schemas/ResponseFormat" }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "required": ["object", "model", "choices"],
        "properties": {
          "object": { "type": "string", "const": "chat.completion" },
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": ["index", "finish_reason", "message"],
              "properties": {
                "index": { "type": "integer", "const": 0 },
                "finish_reason": { "type": "string", "enum": ["stop", "length"] },
                "message": {
                  "type": "object",
                  "required": ["role", "content"],
                  "properties": {
                    "role": { "type": "string", "const": "assistant" },
                    "content": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "ChatTokenCount": {
        "type": "object",
        "required": ["model", "input_tokens", "max_input_tokens", "max_completion_tokens", "exact"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "input_tokens": { "type": "integer", "minimum": 1 },
          "max_input_tokens": { "type": "integer", "minimum": 1 },
          "max_completion_tokens": { "type": "integer", "minimum": 1 },
          "exact": { "type": "boolean", "description": "True for a tokenizer count and false for an estimate." }
        }
      },
      "EmbeddingText": {
        "type": "string",
        "pattern": "\\S",
        "maxLength": 10000
      },
      "EmbeddingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "input"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "input": {
            "oneOf": [
              { "$ref": "#/components/schemas/EmbeddingText" },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "$ref": "#/components/schemas/EmbeddingText" }
              }
            ]
          },
          "encoding_format": { "type": "string", "const": "float", "default": "float" },
          "dimensions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536,
            "description": "Expected vector dimension. The profile must return this dimension."
          }
        }
      },
      "EmbeddingList": {
        "type": "object",
        "required": ["object", "model", "data"],
        "properties": {
          "object": { "type": "string", "const": "list" },
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["index", "embedding", "object"],
              "properties": {
                "index": { "type": "integer", "minimum": 0, "maximum": 31 },
                "embedding": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 65536,
                  "items": { "type": "number", "format": "float" }
                },
                "object": { "type": "string", "const": "embedding" }
              }
            }
          }
        }
      },
      "DecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "digest", "state", "question"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "digest": { "$ref": "#/components/schemas/ArtifactDigest" },
          "state": { "$ref": "#/components/schemas/NonBlankString" },
          "question": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "instructions", "criteria"],
            "properties": {
              "type": { "type": "string", "const": "choice" },
              "instructions": { "type": "string" },
              "criteria": {
                "type": "object",
                "minProperties": 2,
                "propertyNames": { "$ref": "#/components/schemas/NonBlankString" },
                "additionalProperties": { "$ref": "#/components/schemas/NonBlankString" }
              }
            }
          }
        }
      },
      "DecisionResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "digest", "answer", "usage"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "digest": { "$ref": "#/components/schemas/ArtifactDigest" },
          "answer": {
            "type": "object",
            "required": ["type", "choice", "confidence", "probabilities"],
            "properties": {
              "type": { "type": "string", "const": "choice" },
              "choice": { "type": "string", "description": "Key of the selected criterion." },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "probabilities": {
                "type": "object",
                "description": "Model scores by criterion key. Their sum is approximately 1.",
                "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "usage": {
            "type": "object",
            "required": ["input_tokens", "output_tokens"],
            "properties": {
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "DecisionRestriction": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "digest", "reason"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "digest": { "$ref": "#/components/schemas/ArtifactDigest" },
          "reason": { "type": "string", "enum": ["input_limit", "reserved_token", "outside_training_context"] }
        }
      },
      "BGERequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "input", "modes"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "input": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "$ref": "#/components/schemas/EmbeddingText" }
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["dense", "sparse", "colbert"] }
          }
        }
      },
      "BGEVector": {
        "type": "array",
        "minItems": 1024,
        "maxItems": 1024,
        "items": { "type": "number", "format": "float" }
      },
      "BGEResult": {
        "type": "object",
        "required": ["model", "data"],
        "properties": {
          "model": { "$ref": "#/components/schemas/ProfileId" },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "dense": { "$ref": "#/components/schemas/BGEVector" },
                "sparse": {
                  "type": "object",
                  "description": "Positive weights keyed by decimal vocabulary token IDs (0–250001).",
                  "maxProperties": 128,
                  "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" },
                  "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
                },
                "colbert": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": { "$ref": "#/components/schemas/BGEVector" }
                }
              }
            }
          }
        }
      },
      "StatusSnapshot": {
        "type": "object",
        "required": ["checked_at", "models"],
        "properties": {
          "checked_at": { "type": "string", "format": "date-time" },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "id", "model", "provider", "role", "reachability", "listed", "installed", "loaded", "memory"],
              "properties": {
                "name": { "type": "string" },
                "id": { "$ref": "#/components/schemas/ProfileId" },
                "model": { "type": "string", "description": "Model name at the provider." },
                "provider": { "$ref": "#/components/schemas/Provider" },
                "role": { "$ref": "#/components/schemas/ProfileRole" },
                "reachability": {
                  "type": "string",
                  "enum": ["unchecked", "unreachable", "reachable", "metadata_error", "credential_missing"]
                },
                "listed": { "type": ["boolean", "null"] },
                "installed": { "type": ["boolean", "null"] },
                "loaded": { "type": ["boolean", "null"] },
                "memory": { "type": "string", "enum": ["unknown", "cpu", "gpu", "cpu_gpu"] }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": { "type": "string" },
              "code": {
                "type": "string",
                "description": "Machine-readable code for OpenVINO NPU failures.",
                "enum": ["PROFILE_CHANGED", "NPU_UNAVAILABLE", "NPU_WORKER_EXIT", "NPU_RECOVERY_FAILED", "TIMEOUT", "INVALID_OUTPUT", "OUTPUT_TOKEN_LIMIT"]
              }
            }
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Invalid JSON, unsupported fields or options, or a request that does not match the selected profile.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "The Host, Origin, or browser fetch context was rejected.",
        "content": { "text/plain": { "schema": { "type": "string" }, "example": "Forbidden" } }
      },
      "UnknownProfile": {
        "description": "The profile ID is unknown or the profile does not support this operation.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Canceled": {
        "description": "The inference request was canceled while queued.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BodyTooLarge": {
        "description": "The request body exceeds the 2 MiB limit.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "QueueFull": {
        "description": "The inference queue already contains 128 waiting requests.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ProviderFailure": {
        "description": "The provider call failed or returned invalid output. OpenVINO NPU returns OUTPUT_TOKEN_LIMIT when generation reaches the effective completion token cap, or INVALID_OUTPUT for other rejected output.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "DeadlineExceeded": {
        "description": "The inference deadline expired in the queue, or an active OpenVINO NPU request timed out. An NPU timeout has error code TIMEOUT.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BGEConflict": {
        "description": "The OpenVINO BGE-M3 worker profile or device changed.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BGEInputTooLarge": {
        "description": "The body exceeds 2 MiB or the input exceeds the OpenVINO BGE-M3 token limit.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BGEUnavailable": {
        "description": "The OpenVINO BGE-M3 worker is unavailable.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
